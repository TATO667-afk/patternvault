# ---- Supabase (project settings → API) ----
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — never prefix with NEXT_PUBLIC, never import into client components.
# Used only by trusted server code (e.g. admin/maintenance). Optional for the app to run.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (server-side AI; NEVER exposed to the browser) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model id used by the server AI routes:
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Per-user daily AI call quota (cost control):
AI_DAILY_CALL_LIMIT=120

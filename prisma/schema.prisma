generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  steamId     String   @unique
  displayName String
  avatarUrl   String?
  profileUrl  String?
  role        String   @default("user") // user | admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  favorites   UserFavorite[]
  screenshots Screenshot[]
  comments    Comment[]
  collections Collection[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── Pattern Database ─────────────────────────────────────────────────────────

model Weapon {
  id       String @id @default(cuid())
  name     String @unique // "AK-47", "AWP", "Karambit"
  category String         // "Rifle", "Pistol", "Knife", "Gloves", "SMG", "Shotgun"
  slug     String @unique
  skins    Skin[]

  @@map("weapons")
}

model Skin {
  id             String   @id @default(cuid())
  weaponId       String
  weapon         Weapon   @relation(fields: [weaponId], references: [id])
  name           String               // "Case Hardened", "Fade", "Dragon Lore"
  marketHashName String   @unique
  slug           String   @unique
  rarity         String?              // "Covert", "Classified", "Restricted", "Mil-Spec"
  collection     String?              // "The Chroma Collection"
  minFloat       Float?
  maxFloat       Float?
  imageUrl       String?
  description    String?
  releaseDate    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patterns       Pattern[]
  priceHistory   SkinPriceHistory[]

  @@index([weaponId])
  @@map("skins")
}

model Pattern {
  id             String   @id @default(cuid())
  skinId         String
  skin           Skin     @relation(fields: [skinId], references: [id])
  patternId      Int                  // 0–1000 (paintSeed)

  // Attribute breakdowns (0–100%)
  bluePercent    Float?
  goldPercent    Float?
  silverPercent  Float?
  bronzePercent  Float?
  fadePercent    Float?               // for Fade knives

  // Doppler / special
  phase          String?              // "Phase 1"–"Phase 4", "Ruby", "Sapphire", "Black Pearl"

  // Ranking & scoring
  tier           Int      @default(1) // 1 (common) – 5 (legendary)
  isBlueGem      Boolean  @default(false)
  rarityScore    Float?               // 0–100
  collectorScore Float?               // community score
  premiumMulti   Float?               // price multiplier vs base

  imageUrl       String?
  inspectLink    String?
  description    String?
  note           String?              // admin note: "Known craft by player X"

  screenshots    Screenshot[]
  favorites      UserFavorite[]
  comments       Comment[]
  priceHistory   PatternPriceHistory[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([skinId, patternId])
  @@index([skinId])
  @@index([tier])
  @@index([isBlueGem])
  @@index([fadePercent])
  @@map("patterns")
}

model PatternPriceHistory {
  id        String   @id @default(cuid())
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id])
  price     Float
  premium   Float
  source    String   // "steam" | "buff" | "manual"
  soldBy    String?
  soldTo    String?
  date      DateTime
  note      String?

  @@index([patternId, date])
  @@map("pattern_price_history")
}

model SkinPriceHistory {
  id      String   @id @default(cuid())
  skinId  String
  skin    Skin     @relation(fields: [skinId], references: [id])
  price   Float
  date    DateTime
  source  String

  @@index([skinId, date])
  @@map("skin_price_history")
}

// ─── Community ───────────────────────────────────────────────────────────────

model Screenshot {
  id        String   @id @default(cuid())
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  imageUrl  String
  caption   String?
  approved  Boolean  @default(false)
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([patternId])
  @@map("screenshots")
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, patternId])
  @@map("user_favorites")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id])
  body      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patternId])
  @@map("comments")
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean  @default(true)
  patternIds  String[] // array of pattern IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collections")
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  imageUrl    String?
  category    String   // "news" | "guide" | "showcase" | "market"
  authorName  String
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
  @@map("articles")
}
